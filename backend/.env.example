MONGODB_URI=mongodb+srv://<db_username>:<db_password>@<cluster>.mongodb.net/?appName=Cluster0
MONGODB_DB=intellisched_view
PORT=4100
# The main IntelliSched backend, and the same TIMETABLE_API_KEY set in its .env
MAIN_API_URL=http://localhost:4000
MAIN_API_KEY=change-me-to-the-main-apps-TIMETABLE_API_KEY
# Master account on the Teacher sign-in: can view any teacher's or section's timetable.
# Password at least 10 characters. Restart after changing.
MASTER_ID=change-me-master-id
MASTER_PASSWORD=change-me-master-password
# How old the saved copy may get before the next visitor triggers a refresh
SYNC_MINUTES=5
